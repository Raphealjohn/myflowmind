# ── Site ────────────────────────────────────────────────────────────────────
# Canonical URL, no trailing slash. Used for metadata, sitemap, email links.
NEXT_PUBLIC_SITE_URL=https://kayjayholding.com

# ── HubSpot Free CRM (system of record) ─────────────────────────────────────
# Private app token: HubSpot → Settings → Integrations → Private Apps.
# Scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write,
#         crm.schemas.contacts.write, crm.pipelines (deals) read/write.
# Run `npm run setup:hubspot` once after setting this.
# Leave unset locally to use the console CRM stub (forms still work).
HUBSPOT_ACCESS_TOKEN=

# ── Resend (transactional + nurture email) ──────────────────────────────────
# https://resend.com → API Keys. Verify your sending domain first.
RESEND_API_KEY=
# Must be on the verified domain:
EMAIL_FROM="Kayjay Holding <hello@kayjayholding.com>"
# Hot-lead alerts and reply-to target:
FOUNDER_EMAIL=raphealjohn77@gmail.com

# ── Cal.com booking webhook ─────────────────────────────────────────────────
# Cal.com → Settings → Developer → Webhooks. Point at
# {SITE_URL}/api/webhooks/calcom and copy the secret here.
CALCOM_WEBHOOK_SECRET=

# ── Sanity CMS (optional until the studio is connected) ─────────────────────
# When unset, the site serves typed seed content from /lib.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Founder dashboard auth (NextAuth) ───────────────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://kayjayholding.com
ADMIN_EMAIL=raphealjohn77@gmail.com
ADMIN_PASSWORD=

# ── Vercel Cron protection ──────────────────────────────────────────────────
# Vercel sets Authorization: Bearer ${CRON_SECRET} on cron invocations.
CRON_SECRET=

# ── Nurture sequence links ──────────────────────────────────────────────────
# Google review link used by the notary review-request email.
GOOGLE_REVIEW_URL=

# ── "Ask Kayjay" assistant (Anthropic API) ──────────────────────────────────
# https://platform.claude.com → API keys. When unset, the chat widget shows a
# friendly fallback pointing to /contact.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8):
CHAT_MODEL=
