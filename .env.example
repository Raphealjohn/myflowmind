# MyFlowMind — Environment Variables Example
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Contact form backend (e.g. Formspree endpoint)
FORM_ACTION_URL=https://formspree.io/f/YOUR_FORM_ID

# Analytics (e.g. Google Analytics measurement ID)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: SendGrid API key for transactional email
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
